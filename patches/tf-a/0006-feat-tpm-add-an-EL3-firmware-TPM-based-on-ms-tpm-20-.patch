diff --git a/drivers/tpm/ftpm/lib/ftpm_lib.c b/drivers/tpm/ftpm/lib/ftpm_lib.c
new file mode 100644
index 000000000..abb1d8712
--- /dev/null
+++ b/drivers/tpm/ftpm/lib/ftpm_lib.c
@@ -0,0 +1,106 @@
+/*
+ * Copyright (c) 2025, 3mdeb. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Thin interface between TF-A and the MS TPM 2.0 reference implementation.
+ * Built as part of libftpm, i.e. with the TPM include paths and relaxed
+ * warnings; TF-A code only uses the functions declared in
+ * <drivers/tpm/ftpm.h>.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "Tpm.h"
+#include "Platform.h"
+#include "_TPM_Init_fp.h"
+#include "Manufacture_fp.h"
+
+int ftpm_lib_init(void)
+{
+	if (_plat__NVEnable(NULL, 0) < 0) {
+		return -1;
+	}
+
+	/* NV must be available, or the manufacture writes are dropped */
+	_plat__SetNvAvail();
+
+	/*
+	 * The NV image lives in RAM, so the TPM is manufactured on every cold
+	 * boot. _plat__NVNeedsManufacture() is always FALSE without
+	 * FILE_BACKED_NV and cannot be used here.
+	 */
+	if (TPM_Manufacture(1) != 0) {
+		return -2;
+	}
+
+	_plat__Signal_PowerOn();
+	/* Runs _TPM_Init(); TPM2_Startup is left to firmware or the OS */
+	_plat__Signal_Reset();
+
+	return 0;
+}
+
+uint32_t ftpm_lib_execute(uint8_t locality, uint8_t *cmd, uint32_t cmd_len,
+			  uint8_t *rsp, uint32_t rsp_max)
+{
+	uint32_t rsp_len = rsp_max;
+	uint8_t *rsp_buf = rsp;
+
+	_plat__LocalitySet(locality);
+	_plat__RunCommand(cmd_len, cmd, &rsp_len, &rsp_buf);
+
+	/* The TPM may return a pointer to an internal buffer */
+	if ((rsp_buf != rsp) && (rsp_len <= rsp_max)) {
+		memcpy(rsp, rsp_buf, rsp_len);
+	}
+
+	return rsp_len;
+}
+
+/*
+ * DRTM: start a new dynamic chain of trust. TPM2_PCR_Reset() is never
+ * allowed at locality 4 for the DRTM PCRs, the TCG model resets them through
+ * the locality 4 _TPM_Hash_Start/_TPM_Hash_End sequence instead. This does
+ * what _TPM_Hash_End() does before extending PCR 17: reset the dynamic PCRs
+ * (17-22) to zero and count a TPM restart. The caller then extends every
+ * DRTM measurement with TPM2_PCR_Extend() at locality 4, so PCR 17/18 equal
+ * a replay of the DRTM Event Log from zero.
+ */
+void ftpm_lib_drtm_reset_pcrs(void)
+{
+	_plat__LocalitySet(4);
+	PCRResetDynamics();
+	if (TPMIsStarted()) {
+		gr.restartCount++;
+	}
+}
+
+/*
+ * DRTM: extend a measurement into one bank of a DRTM PCR at locality 4. The
+ * bank is the firmware hash algorithm advertised in the DRTM TPM features,
+ * which is also the algorithm of the DRTM Event Log, so the PCR equals a
+ * replay of the Event Log.
+ *
+ * Returns 0 on success, -1 for an invalid PCR or digest size, -2 if the PCR
+ * bank for alg is not allocated.
+ */
+int ftpm_lib_drtm_extend(unsigned int pcr, uint16_t alg, const uint8_t *digest,
+			 uint32_t size)
+{
+	if ((pcr >= IMPLEMENTATION_PCR) ||
+	    (size != CryptHashGetDigestSize(alg))) {
+		return -1;
+	}
+
+	if (!PcrIsAllocated(pcr, alg)) {
+		return -2;
+	}
+
+	_plat__LocalitySet(4);
+	PCRExtend(PCR_FIRST + pcr, alg, size, (BYTE *)digest);
+
+	return 0;
+}
