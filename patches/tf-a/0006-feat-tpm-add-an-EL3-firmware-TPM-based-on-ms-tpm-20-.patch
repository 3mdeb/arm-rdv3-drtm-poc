diff --git a/drivers/tpm/ftpm/ftpm.c b/drivers/tpm/ftpm/ftpm.c
new file mode 100644
index 000000000..abc4e35a0
--- /dev/null
+++ b/drivers/tpm/ftpm/ftpm.c
@@ -0,0 +1,262 @@
+/*
+ * Copyright (c) 2025, 3mdeb. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <assert.h>
+#include <errno.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <common/debug.h>
+#include <common/runtime_svc.h>
+#include <drivers/tpm/ftpm.h>
+#include <lib/mmio.h>
+#include <lib/spinlock.h>
+#include <lib/utils.h>
+#include <lib/utils_def.h>
+
+/* Provided by libftpm (lib/ftpm_lib.c) */
+int ftpm_lib_init(void);
+uint32_t ftpm_lib_execute(uint8_t locality, uint8_t *cmd, uint32_t cmd_len,
+			  uint8_t *rsp, uint32_t rsp_max);
+void ftpm_lib_drtm_reset_pcrs(void);
+int ftpm_lib_drtm_extend(unsigned int pcr, uint16_t alg, const uint8_t *digest,
+			 uint32_t size);
+
+/* Run fn(arg) on the given stack (ftpm_stack.S) */
+uint64_t ftpm_stack_call(void *arg, uint64_t (*fn)(void *), void *stack_top);
+
+/*
+ * The reference implementation keeps big-number temporaries on the stack,
+ * far more than the per-CPU EL3 stacks provide. All TPM work runs on this
+ * stack, serialised by ftpm_lock.
+ */
+#define FTPM_STACK_SIZE		(256U * 1024U)
+#define FTPM_TPM_HDR_SIZE	10U
+#define FTPM_MAX_CMD_SIZE	4096U
+
+static uint8_t ftpm_stack[FTPM_STACK_SIZE] __aligned(16);
+static spinlock_t ftpm_lock;
+
+static ftpm_crb_ctrl_t *crb_ctrl;
+static uint8_t *crb_buf;
+static uint32_t crb_buf_size;
+static bool ftpm_ready;
+
+/* Bounce buffers, so the TPM never works on memory the normal world owns */
+static uint8_t ftpm_cmd[FTPM_MAX_CMD_SIZE];
+static uint8_t ftpm_rsp[FTPM_MAX_CMD_SIZE];
+
+struct ftpm_exec_args {
+	uint8_t locality;
+	uint8_t *cmd;
+	uint32_t cmd_len;
+	uint8_t *rsp;
+	uint32_t rsp_max;
+};
+
+static uint64_t ftpm_init_on_stack(void *arg)
+{
+	(void)arg;
+
+	return (uint64_t)(int64_t)ftpm_lib_init();
+}
+
+static uint64_t ftpm_exec_on_stack(void *arg)
+{
+	struct ftpm_exec_args *a = arg;
+
+	return ftpm_lib_execute(a->locality, a->cmd, a->cmd_len, a->rsp,
+				a->rsp_max);
+}
+
+static uint64_t ftpm_drtm_reset_on_stack(void *arg)
+{
+	(void)arg;
+
+	ftpm_lib_drtm_reset_pcrs();
+	return 0U;
+}
+
+struct ftpm_drtm_extend_args {
+	unsigned int pcr;
+	uint16_t alg;
+	const uint8_t *digest;
+	uint32_t size;
+};
+
+static uint64_t ftpm_drtm_extend_on_stack(void *arg)
+{
+	struct ftpm_drtm_extend_args *a = arg;
+
+	return (uint64_t)(int64_t)ftpm_lib_drtm_extend(a->pcr, a->alg,
+						       a->digest, a->size);
+}
+
+static void *ftpm_stack_top(void)
+{
+	return &ftpm_stack[FTPM_STACK_SIZE];
+}
+
+static uint32_t tpm_be32(const uint8_t *p)
+{
+	return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+	       ((uint32_t)p[2] << 8) | (uint32_t)p[3];
+}
+
+static uint32_t ftpm_execute_locked(uint8_t locality, uint8_t *cmd,
+				    uint32_t cmd_len, uint8_t *rsp,
+				    uint32_t rsp_max)
+{
+	struct ftpm_exec_args args = {
+		.locality = locality,
+		.cmd = cmd,
+		.cmd_len = cmd_len,
+		.rsp = rsp,
+		.rsp_max = rsp_max,
+	};
+
+	return (uint32_t)ftpm_stack_call(&args, ftpm_exec_on_stack,
+					 ftpm_stack_top());
+}
+
+uint32_t ftpm_execute(uint8_t locality, uint8_t *cmd, uint32_t cmd_len,
+		      uint8_t *rsp, uint32_t rsp_max)
+{
+	uint32_t len;
+
+	if (!ftpm_ready || (locality > 4U)) {
+		return 0U;
+	}
+
+	spin_lock(&ftpm_lock);
+	len = ftpm_execute_locked(locality, cmd, cmd_len, rsp, rsp_max);
+	spin_unlock(&ftpm_lock);
+
+	return len;
+}
+
+int ftpm_drtm_reset_pcrs(void)
+{
+	if (!ftpm_ready) {
+		return -ENODEV;
+	}
+
+	spin_lock(&ftpm_lock);
+	(void)ftpm_stack_call(NULL, ftpm_drtm_reset_on_stack, ftpm_stack_top());
+	spin_unlock(&ftpm_lock);
+
+	return 0;
+}
+
+int ftpm_drtm_extend(unsigned int pcr, uint16_t alg, const uint8_t *digest,
+		     uint32_t size)
+{
+	struct ftpm_drtm_extend_args args = {
+		.pcr = pcr,
+		.alg = alg,
+		.digest = digest,
+		.size = size,
+	};
+	int rc;
+
+	if (!ftpm_ready) {
+		return -ENODEV;
+	}
+
+	spin_lock(&ftpm_lock);
+	rc = (int)ftpm_stack_call(&args, ftpm_drtm_extend_on_stack,
+				  ftpm_stack_top());
+	spin_unlock(&ftpm_lock);
+
+	return rc;
+}
+
+uint64_t ftpm_crb_start(void)
+{
+	uint32_t cmd_len;
+	uint32_t rsp_len;
+
+	if (!ftpm_ready) {
+		return SMC_UNK;
+	}
+
+	spin_lock(&ftpm_lock);
+
+	if ((mmio_read_32((uintptr_t)&crb_ctrl->ctrl_start) &
+	     FTPM_CRB_START_INVOKE) == 0U) {
+		/* Nothing to do */
+		goto out;
+	}
+
+	memcpy(ftpm_cmd, crb_buf, FTPM_TPM_HDR_SIZE);
+	cmd_len = tpm_be32(&ftpm_cmd[2]);
+	if ((cmd_len < FTPM_TPM_HDR_SIZE) || (cmd_len > crb_buf_size) ||
+	    (cmd_len > sizeof(ftpm_cmd))) {
+		WARN("fTPM: bad command size %u\n", cmd_len);
+		mmio_write_32((uintptr_t)&crb_ctrl->ctrl_sts,
+			      FTPM_CRB_STS_ERROR);
+		goto done;
+	}
+
+	memcpy(ftpm_cmd, crb_buf, cmd_len);
+	rsp_len = ftpm_execute_locked(0U, ftpm_cmd, cmd_len, ftpm_rsp,
+				      MIN((uint32_t)sizeof(ftpm_rsp),
+					  crb_buf_size));
+	if ((rsp_len < FTPM_TPM_HDR_SIZE) || (rsp_len > crb_buf_size)) {
+		WARN("fTPM: bad response size %u\n", rsp_len);
+		mmio_write_32((uintptr_t)&crb_ctrl->ctrl_sts,
+			      FTPM_CRB_STS_ERROR);
+		goto done;
+	}
+
+	memcpy(crb_buf, ftpm_rsp, rsp_len);
+	mmio_write_32((uintptr_t)&crb_ctrl->ctrl_sts, 0U);
+
+done:
+	/* Command complete: the OS polls for START to clear */
+	mmio_write_32((uintptr_t)&crb_ctrl->ctrl_start, 0U);
+out:
+	spin_unlock(&ftpm_lock);
+
+	return SMC_OK;
+}
+
+int ftpm_init(uintptr_t crb_base, uint32_t buf_offset, uint32_t buf_size)
+{
+	uintptr_t buf_pa = crb_base + buf_offset;
+	int rc;
+
+	assert(buf_offset >= (FTPM_CRB_CTRL_OFFSET + sizeof(ftpm_crb_ctrl_t)));
+
+	crb_ctrl = (ftpm_crb_ctrl_t *)(crb_base + FTPM_CRB_CTRL_OFFSET);
+	crb_buf = (uint8_t *)buf_pa;
+	crb_buf_size = MIN(buf_size, FTPM_MAX_CMD_SIZE);
+
+	/* Locality area is unused with the SMC start method */
+	zeromem((void *)crb_base, buf_offset);
+
+	mmio_write_32((uintptr_t)&crb_ctrl->ctrl_cmd_size, crb_buf_size);
+	mmio_write_32((uintptr_t)&crb_ctrl->ctrl_cmd_pa_low,
+		      (uint32_t)buf_pa);
+	mmio_write_32((uintptr_t)&crb_ctrl->ctrl_cmd_pa_high,
+		      (uint32_t)((uint64_t)buf_pa >> 32));
+	mmio_write_32((uintptr_t)&crb_ctrl->ctrl_rsp_size, crb_buf_size);
+	mmio_write_64((uintptr_t)&crb_ctrl->ctrl_rsp_pa, buf_pa);
+
+	INFO("fTPM: initialising, CRB at 0x%lx\n", crb_base);
+	rc = (int)ftpm_stack_call(NULL, ftpm_init_on_stack, ftpm_stack_top());
+	if (rc != 0) {
+		ERROR("fTPM: initialisation failed (%d)\n", rc);
+		mmio_write_32((uintptr_t)&crb_ctrl->ctrl_sts,
+			      FTPM_CRB_STS_ERROR);
+		return -EIO;
+	}
+
+	ftpm_ready = true;
+	NOTICE("fTPM: ready (PoC, volatile NV)\n");
+
+	return 0;
+}
diff --git a/drivers/tpm/ftpm/ftpm.mk b/drivers/tpm/ftpm/ftpm.mk
new file mode 100644
index 000000000..0030ab216
--- /dev/null
+++ b/drivers/tpm/ftpm/ftpm.mk
@@ -0,0 +1,91 @@
+#
+# Copyright (c) 2025, 3mdeb. All rights reserved.
+#
+# SPDX-License-Identifier: BSD-3-Clause
+#
+# EL3 firmware TPM based on the MS TPM 2.0 reference implementation, using
+# wolfCrypt as crypto library. The third party code is built into libftpm
+# with its own include paths and with warnings disabled.
+#
+# FTPM_MS_TPM_20_REF_DIR: checkout of github.com/microsoft/ms-tpm-20-ref with the
+#                         TpmConfiguration/cryptolibs layout (v1.83, main
+#                         since ee21db0), including the external/wolfssl
+#                         submodule.
+#
+
+FTPM_DIR		:=	drivers/tpm/ftpm
+FTPM_MS_TPM_20_REF_DIR	?=	../ms-tpm-20-ref
+FTPM_WOLFSSL_DIR	?=	$(FTPM_MS_TPM_20_REF_DIR)/external/wolfssl
+
+FTPM_TPM_DIR		:=	$(FTPM_MS_TPM_20_REF_DIR)/TPMCmd
+FTPM_CORE_DIR		:=	$(FTPM_TPM_DIR)/tpm
+FTPM_CRYPTO_DIR		:=	$(FTPM_CORE_DIR)/cryptolibs
+
+ifeq ($(wildcard $(FTPM_CORE_DIR)/src),)
+$(error Error: FTPM_MS_TPM_20_REF_DIR '$(FTPM_MS_TPM_20_REF_DIR)' is not a ms-tpm-20-ref checkout)
+endif
+ifeq ($(wildcard $(FTPM_TPM_DIR)/TpmConfiguration/TpmConfiguration),)
+$(error Error: '$(FTPM_MS_TPM_20_REF_DIR)' has no TPMCmd/TpmConfiguration, ms-tpm-20-ref before v1.83 is not supported)
+endif
+ifeq ($(wildcard $(FTPM_WOLFSSL_DIR)/wolfcrypt/src),)
+$(error Error: wolfSSL not found in '$(FTPM_WOLFSSL_DIR)', run 'git submodule update --init' in ms-tpm-20-ref)
+endif
+
+# TPM core library, TpmBigNum math on top of wolfCrypt, platform library
+FTPM_TPM_SRCS		:=	$(shell find $(FTPM_CORE_DIR)/src -name '*.c')	\
+				$(wildcard $(FTPM_CRYPTO_DIR)/TpmBigNum/*.c)	\
+				$(wildcard $(FTPM_CRYPTO_DIR)/wolf/*.c)
+FTPM_PLAT_SRCS		:=	$(filter-out %/DebugHelpers.c,			\
+				$(wildcard $(FTPM_TPM_DIR)/Platform/src/*.c))
+FTPM_WOLF_SRCS		:=	$(addprefix $(FTPM_WOLFSSL_DIR)/wolfcrypt/src/,	\
+				aes.c des3.c ecc.c integer.c memory.c random.c	\
+				sha.c sha256.c sha512.c tfm.c wolfmath.c)
+
+LIBFTPM_SRCS		:=	$(FTPM_TPM_SRCS)				\
+				$(FTPM_PLAT_SRCS)				\
+				$(FTPM_WOLF_SRCS)				\
+				$(FTPM_DIR)/lib/ftpm_lib.c			\
+				$(FTPM_DIR)/lib/ftpm_compat.c
+
+# libftpm objects are named after the source basename, which must be unique
+ifneq ($(words $(notdir $(LIBFTPM_SRCS))),$(words $(sort $(notdir $(LIBFTPM_SRCS)))))
+$(error Error: duplicate source file names in libftpm)
+endif
+
+# Prepended to TF_CFLAGS by MAKE_C_LIB; -w also silences TF-A's -Werror.
+# lib/config comes before the upstream TpmConfiguration: it overrides the
+# build switches and the algorithm profile (see the headers there).
+libftpm_CFLAGS		:=	-w						\
+				-include $(FTPM_DIR)/lib/ftpm_config.h		\
+				-I$(FTPM_DIR)/lib/include			\
+				-I$(FTPM_DIR)/lib/config			\
+				-I$(FTPM_TPM_DIR)/TpmConfiguration		\
+				-I$(FTPM_CORE_DIR)/include			\
+				-I$(FTPM_CORE_DIR)/include/private		\
+				-I$(FTPM_CORE_DIR)/include/private/prototypes	\
+				-I$(FTPM_CORE_DIR)/include/public		\
+				-I$(FTPM_CORE_DIR)/include/public/prototypes	\
+				-I$(FTPM_CORE_DIR)/include/platform_interface	\
+				-I$(FTPM_CORE_DIR)/include/platform_interface/prototypes \
+				-I$(FTPM_CRYPTO_DIR)/common/include		\
+				-I$(FTPM_CRYPTO_DIR)/TpmBigNum/include		\
+				-I$(FTPM_CRYPTO_DIR)/wolf/include		\
+				-I$(FTPM_CRYPTO_DIR)/wolf/include/Wolf		\
+				-I$(FTPM_TPM_DIR)/Platform/include		\
+				-I$(FTPM_TPM_DIR)/Platform/include/prototypes	\
+				-I$(FTPM_WOLFSSL_DIR)				\
+				-DHASH_LIB=Wolf -DSYM_LIB=Wolf			\
+				-DMATH_LIB=TpmBigNum -DBN_MATH_LIB=Wolf		\
+				-DFILE_BACKED_NV=NO -DVTPM=NO -DGCC		\
+				-DWOLFSSL_USER_SETTINGS -DWOLFSSL_LIB		\
+				-DWOLFSSL_SHA384 -DWOLFSSL_SHA512		\
+				-DWOLFSSL_KEY_GEN -DSINGLE_THREADED		\
+				-DNO_FILESYSTEM -DNO_WRITEV -DWOLFSSL_NO_SOCK	\
+				-DNO_DEV_RANDOM -DNO_ERROR_STRINGS		\
+				-DWOLFSSL_NO_ASM				\
+				-DCUSTOM_RAND_GENERATE_SEED=ftpm_wolf_seed
+
+$(eval $(call MAKE_LIB,ftpm))
+
+BL31_SOURCES		+=	$(FTPM_DIR)/ftpm.c				\
+				$(FTPM_DIR)/ftpm_stack.S
diff --git a/drivers/tpm/ftpm/ftpm_stack.S b/drivers/tpm/ftpm/ftpm_stack.S
new file mode 100644
index 000000000..617d23886
--- /dev/null
+++ b/drivers/tpm/ftpm/ftpm_stack.S
@@ -0,0 +1,29 @@
+/*
+ * Copyright (c) 2025, 3mdeb. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <asm_macros.S>
+
+	.globl	ftpm_stack_call
+
+/*
+ * uint64_t ftpm_stack_call(void *arg, uint64_t (*fn)(void *),
+ *			    void *stack_top);
+ *
+ * Call fn(arg) with SP set to stack_top and restore the original SP after.
+ */
+func ftpm_stack_call
+	stp	x29, x30, [sp, #-16]!
+	mov	x29, sp
+	mov	x3, sp
+	mov	sp, x2
+	/* Keep the caller's SP on the new stack (16-byte aligned) */
+	stp	x3, xzr, [sp, #-16]!
+	blr	x1
+	ldp	x3, x4, [sp], #16
+	mov	sp, x3
+	ldp	x29, x30, [sp], #16
+	ret
+endfunc ftpm_stack_call
diff --git a/drivers/tpm/ftpm/lib/config/TpmConfiguration/TpmBuildSwitches.h b/drivers/tpm/ftpm/lib/config/TpmConfiguration/TpmBuildSwitches.h
new file mode 100644
