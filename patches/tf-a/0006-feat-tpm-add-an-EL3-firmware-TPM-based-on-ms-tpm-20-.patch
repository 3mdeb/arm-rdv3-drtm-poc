--- /dev/null
+++ b/drivers/tpm/ftpm/lib/config/TpmConfiguration/TpmBuildSwitches.h
@@ -0,0 +1,43 @@
+/*
+ * Copyright (c) 2025, 3mdeb. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * EL3 fTPM build switches: the ms-tpm-20-ref TpmConfiguration defaults (a
+ * simulator build) with the switches that do not apply to firmware turned
+ * off. This directory comes first on the include path, so it replaces
+ * <TpmConfiguration/TpmBuildSwitches.h> and pulls in the upstream file.
+ */
+
+#ifndef FTPM_TPM_BUILD_SWITCHES_H
+#define FTPM_TPM_BUILD_SWITCHES_H
+
+#include_next <TpmConfiguration/TpmBuildSwitches.h>
+
+/* No simulator: no file backed NV, debug RNG or key cache */
+#undef SIMULATION
+#define SIMULATION			NO
+#undef CRYPTO_LIB_REPORTING
+#define CRYPTO_LIB_REPORTING		NO
+#undef CERTIFYX509_DEBUG
+#define CERTIFYX509_DEBUG		NO
+#undef USE_DEBUG_RNG
+#define USE_DEBUG_RNG			NO
+
+/* Start-up checks that need a hosted C library or take too long at EL3 */
+#undef LIBRARY_COMPATIBILITY_CHECK
+#define LIBRARY_COMPATIBILITY_CHECK	NO
+#undef COMPILER_CHECKS
+#define COMPILER_CHECKS			NO
+#undef RUNTIME_SIZE_CHECKS
+#define RUNTIME_SIZE_CHECKS		NO
+
+/* Simulator test hook to force failure mode (and print to stderr) */
+#undef ALLOW_FORCE_FAILURE_MODE
+#define ALLOW_FORCE_FAILURE_MODE	NO
+
+/* FAIL_TRACE records __FUNCTION__/__LINE__ of the failure point */
+#undef FAIL_TRACE
+#define FAIL_TRACE			NO
+
+#endif /* FTPM_TPM_BUILD_SWITCHES_H */
diff --git a/drivers/tpm/ftpm/lib/config/TpmConfiguration/TpmProfile_Common.h b/drivers/tpm/ftpm/lib/config/TpmConfiguration/TpmProfile_Common.h
new file mode 100644
index 000000000..de9aab90a
--- /dev/null
+++ b/drivers/tpm/ftpm/lib/config/TpmConfiguration/TpmProfile_Common.h
@@ -0,0 +1,39 @@
+/*
+ * Copyright (c) 2025, 3mdeb. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * EL3 fTPM algorithm profile: the ms-tpm-20-ref TpmConfiguration defaults,
+ * reduced to the algorithm set of the previous ms-tpm-20-ref profile
+ * (98b60a44) that the PoC was validated with. wolfCrypt is built without
+ * Camellia, SM2/SM4 and the extra curves, and RSA 3072/4096 key generation is
+ * too slow for an SMC handler.
+ */
+
+#ifndef FTPM_TPM_PROFILE_COMMON_H
+#define FTPM_TPM_PROFILE_COMMON_H
+
+#include_next <TpmConfiguration/TpmProfile_Common.h>
+
+#undef ALG_CAMELLIA
+#define ALG_CAMELLIA			ALG_NO
+#undef ALG_ECMQV
+#define ALG_ECMQV			(NO * ALG_ECC)
+#undef ALG_SM2
+#define ALG_SM2				(NO * ALG_ECC)
+
+#undef ECC_NIST_P192
+#define ECC_NIST_P192			(NO * ALG_ECC)
+#undef ECC_NIST_P224
+#define ECC_NIST_P224			(NO * ALG_ECC)
+#undef ECC_NIST_P521
+#define ECC_NIST_P521			(NO * ALG_ECC)
+#undef ECC_BN_P638
+#define ECC_BN_P638			(NO * ALG_ECC)
+
+#undef RSA_3072
+#define RSA_3072			(NO * ALG_RSA)
+#undef RSA_4096
