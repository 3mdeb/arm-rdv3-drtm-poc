diff --git a/drivers/tpm/ftpm/lib/ftpm_compat.c b/drivers/tpm/ftpm/lib/ftpm_compat.c
new file mode 100644
index 000000000..6a104f5cc
--- /dev/null
+++ b/drivers/tpm/ftpm/lib/ftpm_compat.c
@@ -0,0 +1,263 @@
+/*
+ * Copyright (c) 2025, 3mdeb. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * libc and OS services needed by the MS TPM 2.0 reference implementation
+ * and wolfCrypt when running at EL3. PoC quality: the entropy source falls
+ * back to a timer-seeded PRNG when FEAT_RNG is not implemented.
+ */
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <arch.h>
+#include <arch_helpers.h>
+#include <common/debug.h>
+
+/* Time, derived from the generic timer */
+
+static uint64_t ftpm_timer_ms(void)
+{
+	return (read_cntpct_el0() * 1000U) / read_cntfrq_el0();
+}
+
+int clock_gettime(int clk_id, struct timespec *tp)
+{
+	uint64_t ms = ftpm_timer_ms();
+
+	(void)clk_id;
+	tp->tv_sec = (time_t)(ms / 1000U);
+	tp->tv_nsec = (long)((ms % 1000U) * 1000000U);
+
+	return 0;
+}
+
+clock_t clock(void)
+{
+	return (clock_t)ftpm_timer_ms();
+}
+
+time_t time(time_t *t)
+{
+	time_t now = (time_t)(ftpm_timer_ms() / 1000U);
+
+	if (t != NULL) {
+		*t = now;
+	}
+
+	return now;
+}
+
+int strncasecmp(const char *s1, const char *s2, size_t n)
+{
+	int c1 = 0;
+	int c2 = 0;
+
+	while (n-- > 0U) {
+		c1 = (unsigned char)*s1++;
+		c2 = (unsigned char)*s2++;
+		if ((c1 >= 'A') && (c1 <= 'Z')) {
+			c1 += 'a' - 'A';
+		}
+		if ((c2 >= 'A') && (c2 <= 'Z')) {
+			c2 += 'a' - 'A';
+		}
+		if ((c1 != c2) || (c1 == 0)) {
+			break;
+		}
+	}
+
+	return c1 - c2;
+}
+
+int getpid(void)
+{
+	return 1;
+}
+
+void ftpm_assert_fail(const char *file, unsigned int line)
+{
+	ERROR("fTPM: assertion failed at %s:%u\n", file, line);
+	panic();
+}
+
+/* Random numbers: FEAT_RNG if present, xorshift64 otherwise */
+
+static uint64_t prng_state = 0x9e3779b97f4a7c15ULL;
+
+void srand(unsigned int seed)
+{
+	prng_state ^= ((uint64_t)seed << 32) | seed;
+	prng_state ^= read_cntpct_el0();
+	if (prng_state == 0U) {
+		prng_state = 0x9e3779b97f4a7c15ULL;
+	}
+}
+
+static uint64_t ftpm_rndr(uint64_t *val)
+{
+	uint64_t ok;
+
+	/* RNDR sets NZCV.Z on failure */
+	__asm__ volatile("mrs	%0, s3_3_c2_c4_0\n"
+			 "cset	%1, ne\n"
+			 : "=r" (*val), "=r" (ok) : : "cc");
+	return ok;
+}
+
+int rand(void)
+{
+	uint64_t v;
+
+	if ((((read_id_aa64isar0_el1() >> ID_AA64ISAR0_RNDR_SHIFT) &
+	      ID_AA64ISAR0_RNDR_MASK) != 0U) && (ftpm_rndr(&v) != 0U)) {
+		return (int)(v & RAND_MAX);
+	}
+
+	prng_state ^= prng_state << 13;
+	prng_state ^= prng_state >> 7;
+	prng_state ^= prng_state << 17;
+	prng_state ^= read_cntpct_el0();
+
+	return (int)(prng_state & RAND_MAX);
+}
+
+/* wolfCrypt RNG seed, see CUSTOM_RAND_GENERATE_SEED */
+int ftpm_wolf_seed(unsigned char *output, unsigned int sz)
+{
+	unsigned int i;
+
+	for (i = 0U; i < sz; i++) {
+		output[i] = (unsigned char)rand();
+	}
+
+	return 0;
+}
+
+/*
+ * Heap: first-fit allocator with coalescing on free. All fTPM calls are
+ * serialised by the caller, so no locking is needed here.
+ */
+
+#define FTPM_HEAP_SIZE		(256U * 1024U)
+#define FTPM_HEAP_ALIGN		16U
+
+struct heap_blk {
+	size_t size;		/* payload size, multiple of FTPM_HEAP_ALIGN */
+	size_t free;
+	struct heap_blk *next;
+	size_t pad;
+};
+
+static uint8_t ftpm_heap[FTPM_HEAP_SIZE] __aligned(FTPM_HEAP_ALIGN);
+static struct heap_blk *heap_head;
+
+static void heap_init(void)
+{
+	heap_head = (struct heap_blk *)ftpm_heap;
+	heap_head->size = FTPM_HEAP_SIZE - sizeof(struct heap_blk);
+	heap_head->free = 1U;
+	heap_head->next = NULL;
+}
+
+void *malloc(size_t size)
+{
+	struct heap_blk *b;
+
+	if (heap_head == NULL) {
+		heap_init();
+	}
+
+	if (size == 0U) {
+		return NULL;
+	}
+
+	size = (size + FTPM_HEAP_ALIGN - 1U) & ~(size_t)(FTPM_HEAP_ALIGN - 1U);
+
+	for (b = heap_head; b != NULL; b = b->next) {
+		if ((b->free == 0U) || (b->size < size)) {
+			continue;
+		}
+
+		/* Split if the remainder can hold another block */
+		if (b->size >= size + sizeof(struct heap_blk) + FTPM_HEAP_ALIGN) {
+			struct heap_blk *n = (struct heap_blk *)
+				((uint8_t *)(b + 1) + size);
+
+			n->size = b->size - size - sizeof(struct heap_blk);
+			n->free = 1U;
+			n->next = b->next;
+			b->size = size;
+			b->next = n;
+		}
+
+		b->free = 0U;
+		return b + 1;
+	}
+
+	return NULL;
+}
+
+void free(void *ptr)
+{
+	struct heap_blk *b;
+
+	if (ptr == NULL) {
+		return;
+	}
+
+	((struct heap_blk *)ptr - 1)->free = 1U;
+
+	/* Coalesce adjacent free blocks */
+	for (b = heap_head; b != NULL; b = b->next) {
+		while ((b->free != 0U) && (b->next != NULL) &&
+		       (b->next->free != 0U)) {
+			b->size += sizeof(struct heap_blk) + b->next->size;
+			b->next = b->next->next;
+		}
+	}
+}
+
+void *calloc(size_t nmemb, size_t size)
+{
+	size_t total = nmemb * size;
+	void *p;
+
+	if ((size != 0U) && (total / size != nmemb)) {
+		return NULL;
+	}
+
+	p = malloc(total);
+	if (p != NULL) {
+		memset(p, 0, total);
+	}
+
+	return p;
+}
+
+void *realloc(void *ptr, size_t size)
+{
+	struct heap_blk *b;
+	void *n;
+
+	if (ptr == NULL) {
+		return malloc(size);
+	}
+
+	b = (struct heap_blk *)ptr - 1;
+	if (b->size >= size) {
+		return ptr;
+	}
+
+	n = malloc(size);
+	if (n != NULL) {
+		memcpy(n, ptr, b->size);
+		free(ptr);
+	}
+
+	return n;
+}
