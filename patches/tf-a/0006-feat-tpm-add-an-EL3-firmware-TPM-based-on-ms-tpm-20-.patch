diff --git a/include/drivers/tpm/ftpm.h b/include/drivers/tpm/ftpm.h
new file mode 100644
index 000000000..a1ef620c9
--- /dev/null
+++ b/include/drivers/tpm/ftpm.h
@@ -0,0 +1,71 @@
+/*
+ * Copyright (c) 2025, 3mdeb. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Firmware TPM running in EL3, based on the MS TPM 2.0 reference
+ * implementation. The normal world reaches it through a TCG CRB interface
+ * whose start method is an SMC ("Command Response Buffer with Arm SMC",
+ * ACPI TPM2 start method 11).
+ *
+ * This is proof-of-concept code: the TPM state is kept in RAM only, and the
+ * entropy source falls back to a timer-seeded PRNG when FEAT_RNG is missing.
+ */
+
+#ifndef FTPM_H
+#define FTPM_H
+
+#include <stdint.h>
+
+/* TCG PC Client Platform TPM Profile, CRB control area (follows locality area) */
+typedef struct {
+	uint32_t ctrl_req;
+	uint32_t ctrl_sts;
+	uint32_t ctrl_cancel;
+	uint32_t ctrl_start;
+	uint32_t ctrl_int_enable;
+	uint32_t ctrl_int_sts;
+	uint32_t ctrl_cmd_size;
+	uint32_t ctrl_cmd_pa_low;
+	uint32_t ctrl_cmd_pa_high;
+	uint32_t ctrl_rsp_size;
+	uint64_t ctrl_rsp_pa;
+} __packed ftpm_crb_ctrl_t;
+
+#define FTPM_CRB_CTRL_OFFSET		U(0x40)
+#define FTPM_CRB_START_INVOKE		BIT_32(0)
+#define FTPM_CRB_STS_ERROR		BIT_32(0)
+
+/*
+ * Initialise the TPM and the CRB area at crb_base. The command/response
+ * buffer is placed at crb_base + buf_offset and is buf_size bytes long.
+ * The CRB area must be mapped non-cacheable by the caller.
+ */
+int ftpm_init(uintptr_t crb_base, uint32_t buf_offset, uint32_t buf_size);
+
+/* Handle a CRB start request issued by the normal world. Returns SMC_OK. */
+uint64_t ftpm_crb_start(void);
+
+/*
+ * D-CRTM: reset the dynamic PCRs (17-22) to zero, as the locality 4
+ * _TPM_Hash_Start/_TPM_Hash_End sequence does (TPM2_PCR_Reset is not allowed
+ * at locality 4 for them). Returns 0 on success.
+ */
+int ftpm_drtm_reset_pcrs(void);
+
+/*
+ * D-CRTM: extend a digest into the alg bank of a DRTM PCR at locality 4.
+ * Fails if that bank is not allocated or size is not alg's digest size.
+ * Returns 0 on success.
+ */
+int ftpm_drtm_extend(unsigned int pcr, uint16_t alg, const uint8_t *digest,
+		     uint32_t size);
