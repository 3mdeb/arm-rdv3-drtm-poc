From 182c2fec86f0509e47c964f1c092c13f6d283007 Mon Sep 17 00:00:00 2001
From: Pranav Madhu <pranav.madhu@arm.com>
Date: Wed, 18 Sep 2024 20:28:02 +0530
Subject: [PATCH 06/15] feat(neoverse-rd): enable graceful reset support for
 RD-V3
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Enable graceful reset support for the RD-V3 platform. Enabling this
flag will allow the application processor to execute the dynamic
power-down sequence before the power controller statically powers
off the AP cores.

For reference design platforms, when the non-secure OS requests a
shutdown or reboot, one of the application cores will invoke a PSCI
call to enter TF-A. Upon receiving the PSCI command, this CPU core
will notify the other online CPU cores using SGI 15. Set the priority
for SGI 15 to the highest available value (zero).

Change-Id: I39dd6247569960aaffd543b774f66c936a78b62d
Change-Id: I5eb0618bad24c675350315dfd7bee8475b829d5c
Signed-off-by: Pranav Madhu <pranav.madhu@arm.com>
(cherry picked from RD-INFRA-2025.07.03 commits
 8e750e2c914415b07c29f143b919b10fc30e0cec and
 c394e5958febecc3e6f8ea542d00f25813061d7f)
[Michał Iwanicki: squash the two commits and drop the RD-INFRA error
 injection priority from PLAT_EHF_DESC, which upstream lacks, as the
 RD-N2 definitions in nrd_plat_arm_def2.h do.]
Signed-off-by: Michał Iwanicki <michal.iwanicki@3mdeb.com>
---
 .../board/neoverse_rd/common/include/nrd3/nrd_plat_arm_def3.h | 4 ++++
 plat/arm/board/neoverse_rd/platform/rdv3/platform.mk          | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/plat/arm/board/neoverse_rd/common/include/nrd3/nrd_plat_arm_def3.h b/plat/arm/board/neoverse_rd/common/include/nrd3/nrd_plat_arm_def3.h
index 07831225d..2fe2ba58a 100644
--- a/plat/arm/board/neoverse_rd/common/include/nrd3/nrd_plat_arm_def3.h
+++ b/plat/arm/board/neoverse_rd/common/include/nrd3/nrd_plat_arm_def3.h
@@ -255,6 +255,10 @@
 #define PLAT_SP_PRI			U(0x10)
 #endif
 
+/* Interrupt priority level for shutdown/reboot */
+#define PLAT_REBOOT_PRI		GIC_HIGHEST_SEC_PRIORITY
+#define PLAT_EHF_DESC		EHF_PRI_DESC(PLAT_PRI_BITS, PLAT_REBOOT_PRI)
+
 #define ARM_IRQ_SEC_PHY_TIMER		U(29)
 
 #define ARM_IRQ_SEC_SGI_0		U(8)
diff --git a/plat/arm/board/neoverse_rd/platform/rdv3/platform.mk b/plat/arm/board/neoverse_rd/platform/rdv3/platform.mk
index a9ab14d6d..036c386ba 100644
--- a/plat/arm/board/neoverse_rd/platform/rdv3/platform.mk
+++ b/plat/arm/board/neoverse_rd/platform/rdv3/platform.mk
@@ -21,6 +21,10 @@ endif
 override ARM_ARCH_MAJOR			:= 8
 override ARM_ARCH_MINOR			:= 7
 
+# Image flags
+override CSS_SYSTEM_GRACEFUL_RESET	:= 1
+override EL3_EXCEPTION_HANDLING		:= 1
+
 # Misc options
 override CTX_INCLUDE_AARCH32_REGS	:= 0
 
