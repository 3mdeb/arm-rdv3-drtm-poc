From 795af965e9d0956c95ba23d2c830dd3aa514e6ed Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20Iwanicki?= <michal.iwanicki@3mdeb.com>
Date: Wed, 28 Oct 2026 15:16:32 +0100
Subject: [PATCH 27/28] feat(drtm): add a platform hook to cap the unused PCR
 banks
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

DEN0113 R44210 requires the D-CRTM of a firmware-based DRTM to cap PCR
17 and 18 in every PCR bank that is active but unused by DRTM, by
extending a digest of all zero bits. The DRTM measurements use the one
bank of TPM_ALG_ID, so PCR 17 and 18 in the other active banks stay at
their reset value.

Add the optional platform hook plat_drtm_tpm_cap_unused_banks(), called
with TPM_ALG_ID right after plat_drtm_tpm_reset_pcrs(). The weak default
does nothing, for platforms without a TPM reachable from EL3. A failure
fails the dynamic launch.

Signed-off-by: Michał Iwanicki <michal.iwanicki@3mdeb.com>
---
 include/plat/common/plat_drtm.h           |  9 +++++++++
 services/std_svc/drtm/drtm_measurements.c | 15 +++++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/include/plat/common/plat_drtm.h b/include/plat/common/plat_drtm.h
index 49a254d24..ec1f850a6 100644
--- a/include/plat/common/plat_drtm.h
+++ b/include/plat/common/plat_drtm.h
@@ -76,6 +76,15 @@ int plat_drtm_tpm_reset_pcrs(void);
 int plat_drtm_tpm_extend(unsigned int pcr, uint16_t alg_id,
 			 const unsigned char *digest, size_t digest_size);
 
+/*
+ * Optional, for platforms whose TPM is reachable from EL3. Called after
+ * plat_drtm_tpm_reset_pcrs() to cap PCR 17 and 18 in every active PCR bank
+ * other than alg_id, the bank of the DRTM measurements, by extending an
+ * all-zero digest (DEN0113 R44210). The weak default does nothing. A
+ * non-zero return fails the dynamic launch.
+ */
+int plat_drtm_tpm_cap_unused_banks(uint16_t alg_id);
+
 /*
  * Optional. The 1-byte values the DCE measures into PCR 18 (DEN0113 Table
  * 19): plat_drtm_get_debug_config() returns 0x01 if external debug or
diff --git a/services/std_svc/drtm/drtm_measurements.c b/services/std_svc/drtm/drtm_measurements.c
index 8f4ad3a1d..7d5f6603b 100644
--- a/services/std_svc/drtm/drtm_measurements.c
+++ b/services/std_svc/drtm/drtm_measurements.c
@@ -30,12 +30,20 @@ static uint8_t drtm_event_log[PLAT_DRTM_EVENT_LOG_MAX_SIZE];
  */
 #pragma weak plat_drtm_tpm_reset_pcrs
 #pragma weak plat_drtm_tpm_extend
+#pragma weak plat_drtm_tpm_cap_unused_banks
 
 int plat_drtm_tpm_reset_pcrs(void)
 {
 	return 0;
 }
 
+int plat_drtm_tpm_cap_unused_banks(uint16_t alg_id)
+{
+	(void)alg_id;
+
+	return 0;
+}
+
 int plat_drtm_tpm_extend(unsigned int pcr, uint16_t alg_id,
 			 const unsigned char *digest, size_t digest_size)
 {
@@ -266,6 +274,13 @@ enum drtm_retc drtm_take_measurements(const struct_drtm_dl_args *a)
 		return INTERNAL_ERROR;
 	}
 
+	/* Cap PCR 17 and 18 in the active banks the measurements do not use */
+	rc = plat_drtm_tpm_cap_unused_banks(TPM_ALG_ID);
+	if (rc != 0) {
+		ERROR("DRTM: failed to cap the unused PCR banks (%d)\n", rc);
+		return INTERNAL_ERROR;
+	}
+
 	/**
 	 * Measurements extended into PCR-17.
 	 *
-- 
