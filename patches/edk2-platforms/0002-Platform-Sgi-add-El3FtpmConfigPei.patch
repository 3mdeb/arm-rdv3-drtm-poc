+  FILE_GUID                      = 6e1a6c5b-3b54-4e77-9d2b-8a34f1c0e5d2
+  MODULE_TYPE                    = PEIM
+  VERSION_STRING                 = 1.0
+  ENTRY_POINT                    = El3FtpmConfigPeimEntryPoint
