diff --git a/Platform/ARM/SgiPkg/Library/PlatformLib/PlatformLibMem.c b/Platform/ARM/SgiPkg/Library/PlatformLib/PlatformLibMem.c
index 35210285..66ae4dc4 100644
--- a/Platform/ARM/SgiPkg/Library/PlatformLib/PlatformLibMem.c
+++ b/Platform/ARM/SgiPkg/Library/PlatformLib/PlatformLibMem.c
@@ -16,9 +16,12 @@
 #include <IoVirtSoCExp.h>
 #include <SgiPlatform.h>
 
+#include <RdV3El3Ftpm.h>
+
 // Total number of descriptors, including the final "end-of-table" descriptor.
 #define MAX_VIRTUAL_MEMORY_MAP_DESCRIPTORS                                                  \
           ((14 + (FixedPcdGet32 (PcdChipCount) * 2)) +                                      \
+          (FeaturePcdGet (PcdEl3FtpmEnable)) +                                              \
           (FeaturePcdGet (PcdEinjSupported)) +                                              \
            ((FeaturePcdGet (PcdPcieEnable) == TRUE) ? (FixedPcdGet32 (PcdChipCount)) : 0) +  \
            (FixedPcdGet32 (PcdIoVirtSocExpBlkUartEnable) *                                  \
@@ -332,6 +335,14 @@ ArmPlatformGetVirtualMemoryMap (
     VirtualMemoryTable[Index].Attributes      = ARM_MEMORY_REGION_ATTRIBUTE_UNCACHED_UNBUFFERED;
   }
 
+  if (FeaturePcdGet (PcdEl3FtpmEnable)) {
+    // TF-A EL3 firmware TPM: CRB control area and command/response buffer
+    VirtualMemoryTable[++Index].PhysicalBase  = RDV3_EL3_FTPM_CRB_BASE;
+    VirtualMemoryTable[Index].VirtualBase     = RDV3_EL3_FTPM_CRB_BASE;
+    VirtualMemoryTable[Index].Length          = RDV3_EL3_FTPM_CRB_SIZE;
+    VirtualMemoryTable[Index].Attributes      = ARM_MEMORY_REGION_ATTRIBUTE_DEVICE;
+  }
+
   // End of Table
   VirtualMemoryTable[++Index].PhysicalBase  = 0;
   VirtualMemoryTable[Index].VirtualBase     = 0;
diff --git a/Platform/ARM/SgiPkg/RdV3/RdV3.dsc b/Platform/ARM/SgiPkg/RdV3/RdV3.dsc
index 4b6a3e5f..0f1739f0 100644
--- a/Platform/ARM/SgiPkg/RdV3/RdV3.dsc
+++ b/Platform/ARM/SgiPkg/RdV3/RdV3.dsc
@@ -61,4 +61,16 @@ DEFINE PCIE_ENABLE             = TRUE
 ################################################################################
 
 [Components.common]
+!if $(EDK2_ENABLE_EL3_FTPM) == TRUE
+  Platform/ARM/SgiPkg/AcpiTables/RdV3AcpiTablesEl3Ftpm.inf
+!else
   Platform/ARM/SgiPkg/AcpiTables/RdV3AcpiTables.inf
+!endif
+
+#
+# TF-A EL3 firmware TPM (PoC, TF-A NRD_EL3_FTPM=1): ACPI description and the
+# TCG2 driver stack
+#
+!if $(EDK2_ENABLE_EL3_FTPM) == TRUE
+!include Platform/ARM/SgiPkg/El3Ftpm.dsc.inc
+!endif
diff --git a/Platform/ARM/SgiPkg/RdV3/RdV3.fdf.inc b/Platform/ARM/SgiPkg/RdV3/RdV3.fdf.inc
index 89140426..8f9cf6bc 100644
--- a/Platform/ARM/SgiPkg/RdV3/RdV3.fdf.inc
+++ b/Platform/ARM/SgiPkg/RdV3/RdV3.fdf.inc
@@ -7,4 +7,12 @@
 # Per-platform additional content of the DXE phase firmware volume
 
   # ACPI support
+!if $(EDK2_ENABLE_EL3_FTPM) == TRUE
+  INF RuleOverride=ACPITABLE Platform/ARM/SgiPkg/AcpiTables/RdV3AcpiTablesEl3Ftpm.inf
+
+  # TCG2 (TPM 2.0) support for the EL3 firmware TPM
+  INF SecurityPkg/Tcg/Tcg2Dxe/Tcg2Dxe.inf
+  INF SecurityPkg/Tcg/Tcg2Config/Tcg2ConfigDxe.inf
+!else
   INF RuleOverride=ACPITABLE Platform/ARM/SgiPkg/AcpiTables/RdV3AcpiTables.inf
+!endif
