From 05067d9a1b07d12fe6aaafd3f1c1ff645f01d9f9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20=C5=BBygowski?= <michal.zygowski@3mdeb.com>
Date: Fri, 2 Oct 2026 12:20:21 +0200
Subject: [PATCH 4/4] Platform/Sgi: enable the EL3 fTPM and TCG2 measured boot
 on RD-V3

Use EDK2_ENABLE_EL3_FTPM to set PcdEl3FtpmEnable and add the TCG2 stack
(El3FtpmConfigPei, Tcg2Pei, Tcg2Dxe, Tcg2ConfigDxe), measured boot of
PE/COFF images and the GPT, the TPM2 ACPI tables, and map the CRB pages as
device memory. Set the PcdTpm2HashMask to extend SHA-256 and SHA-384, the
banks the Microsoft reference TPM code allocates by default.

Signed-off-by: Michał Żygowski <michal.zygowski@3mdeb.com>
---
 Platform/ARM/SgiPkg/El3Ftpm.dsc.inc           | 81 +++++++++++++++++++
 .../Library/PlatformLib/PlatformLib.inf       |  1 +
 .../Library/PlatformLib/PlatformLibMem.c      | 11 +++
 Platform/ARM/SgiPkg/RdV3/RdV3.dsc             | 12 +++
 Platform/ARM/SgiPkg/RdV3/RdV3.fdf.inc         |  8 ++
 Platform/ARM/SgiPkg/SgiPlatform.dec           |  2 +
 Platform/ARM/SgiPkg/SgiPlatform.dsc.inc       | 11 ++-
 Platform/ARM/SgiPkg/SgiPlatform.fdf           |  4 +
 8 files changed, 127 insertions(+), 3 deletions(-)
 create mode 100644 Platform/ARM/SgiPkg/El3Ftpm.dsc.inc

diff --git a/Platform/ARM/SgiPkg/El3Ftpm.dsc.inc b/Platform/ARM/SgiPkg/El3Ftpm.dsc.inc
new file mode 100644
index 00000000..27020f25
--- /dev/null
+++ b/Platform/ARM/SgiPkg/El3Ftpm.dsc.inc
@@ -0,0 +1,81 @@
+## @file
+#  TCG2 (TPM 2.0) support for the TF-A EL3 firmware TPM (proof of concept).
+#
+#  The TPM is reached through the CRB interface with the Arm SMC start
+#  method, see Library/Tpm2DeviceLibCrbSmc. Requires TF-A built with
+#  NRD_EL3_FTPM=1.
+#
+#  Copyright (c) 2025, 3mdeb. All rights reserved.
+#
+#  SPDX-License-Identifier: BSD-2-Clause-Patent
+##
+
+[LibraryClasses.common]
+  Tpm2DeviceLib|Platform/ARM/SgiPkg/Library/Tpm2DeviceLibCrbSmc/Tpm2DeviceLibCrbSmc.inf
+  Tpm2CommandLib|SecurityPkg/Library/Tpm2CommandLib/Tpm2CommandLib.inf
+  Tpm12DeviceLib|SecurityPkg/Library/Tpm12DeviceLibDTpm/Tpm12DeviceLibDTpm.inf
+  Tpm12CommandLib|SecurityPkg/Library/Tpm12CommandLib/Tpm12CommandLib.inf
+  Tcg2PpVendorLib|SecurityPkg/Library/Tcg2PpVendorLibNull/Tcg2PpVendorLibNull.inf
+  TpmPlatformHierarchyLib|SecurityPkg/Library/PeiDxeTpmPlatformHierarchyLibNull/PeiDxeTpmPlatformHierarchyLib.inf
+
+[LibraryClasses.common.PEIM]
+  BaseCryptLib|CryptoPkg/Library/BaseCryptLib/PeiCryptLib.inf
+  Tcg2PhysicalPresenceLib|SecurityPkg/Library/PeiTcg2PhysicalPresenceLib/PeiTcg2PhysicalPresenceLib.inf
+
+[LibraryClasses.common.DXE_DRIVER, LibraryClasses.common.UEFI_DRIVER, LibraryClasses.common.UEFI_APPLICATION]
+  Tcg2PhysicalPresenceLib|SecurityPkg/Library/DxeTcg2PhysicalPresenceLib/DxeTcg2PhysicalPresenceLib.inf
+
+[LibraryClasses.common.DXE_DRIVER, LibraryClasses.common.DXE_RUNTIME_DRIVER, LibraryClasses.common.UEFI_DRIVER, LibraryClasses.common.UEFI_APPLICATION]
+  # Let other drivers (e.g. variable services) log measurements through TCG2
+  TpmMeasurementLib|SecurityPkg/Library/DxeTpmMeasurementLib/DxeTpmMeasurementLib.inf
+
+[PcdsFeatureFlag.common]
+  gArmSgiTokenSpaceGuid.PcdEl3FtpmEnable|TRUE
+
+[PcdsFixedAtBuild.common]
+  gEfiSecurityPkgTokenSpaceGuid.PcdTpmBaseAddress|0xF7400000
+  # The CRB/SMC interface cannot be probed, use the configured device
+  gEfiSecurityPkgTokenSpaceGuid.PcdTpmAutoDetection|FALSE
+
+[PcdsDynamicDefault.common]
+  # Send TPM2_Startup in PEI (also written by Tcg2ConfigDxe)
+  gEfiSecurityPkgTokenSpaceGuid.PcdTpmInitializationPolicy|1
+  gEfiSecurityPkgTokenSpaceGuid.PcdTpm2InitializationPolicy|1
+  # gEfiTpmDeviceInstanceTpm20DtpmGuid
+  gEfiSecurityPkgTokenSpaceGuid.PcdTpmInstanceGuid|{0x5a, 0xf2, 0x6b, 0x28, 0xc3, 0xc2, 0x8c, 0x40, 0xb3, 0xb4, 0x25, 0xe6, 0x75, 0x8b, 0x73, 0x17}
+  #
+  # Must match the banks the fTPM allocates: SHA256 and SHA384 (the
+  # ms-tpm-20-ref default since v1.83; SHA1 is supported but not allocated).
+  # A bank allocated by the TPM but missing here makes Tcg2Pei reallocate the
+  # PCR banks and reset the platform, which loops forever because the fTPM
+  # state is volatile. A bank set here but not allocated is only dropped from
+  # every event ("Event log has HashAlg unsupported by PCR bank").
+  #
+  gEfiSecurityPkgTokenSpaceGuid.PcdTpm2HashMask|0x00000006
+  gEfiSecurityPkgTokenSpaceGuid.PcdTcg2HashAlgorithmBitmap|0
+  gEfiSecurityPkgTokenSpaceGuid.PcdTcgPhysicalPresenceInterfaceVer|"1.3"
+  gEfiSecurityPkgTokenSpaceGuid.PcdTpm2AcpiTableRev|4
+
+[Components.common]
+  #
+  # PEI
+  #
+  # Replaces Tcg2ConfigPei, which would select a TPM 1.2 device
+  Platform/ARM/SgiPkg/Drivers/El3FtpmConfigPei/El3FtpmConfigPei.inf
+  SecurityPkg/Tcg/Tcg2Pei/Tcg2Pei.inf {
+    <LibraryClasses>
+      HashLib|SecurityPkg/Library/HashLibBaseCryptoRouter/HashLibBaseCryptoRouterPei.inf
+      NULL|SecurityPkg/Library/HashInstanceLibSha256/HashInstanceLibSha256.inf
+      NULL|SecurityPkg/Library/HashInstanceLibSha384/HashInstanceLibSha384.inf
+  }
+
+  #
+  # DXE
+  #
+  SecurityPkg/Tcg/Tcg2Dxe/Tcg2Dxe.inf {
+    <LibraryClasses>
+      HashLib|SecurityPkg/Library/HashLibBaseCryptoRouter/HashLibBaseCryptoRouterDxe.inf
+      NULL|SecurityPkg/Library/HashInstanceLibSha256/HashInstanceLibSha256.inf
+      NULL|SecurityPkg/Library/HashInstanceLibSha384/HashInstanceLibSha384.inf
+  }
+  SecurityPkg/Tcg/Tcg2Config/Tcg2ConfigDxe.inf
